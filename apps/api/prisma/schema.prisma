// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SUPER_ADMIN     // Platform yöneticisi (tüm kliniklere erişebilir)
  ADMIN           // Klinik yöneticisi (kendi kliniğini yönetir)
  THERAPIST       // Terapist
  RECEPTIONIST    // Resepsiyonist/Asistan
  ACCOUNTANT      // Muhasebe
  CLIENT          // Hasta/Danışan
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum SessionNoteStatus {
  DRAFT
  COMPLETED
  REVIEWED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  CANCELLED
  FAILED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  ONLINE
  INSURANCE
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum LocationType {
  BRANCH
  FLOOR
  ONLINE
}

enum RoomType {
  INDIVIDUAL
  GROUP
  PLAY_THERAPY
  EMDR
  COUPLE
  OTHER
}

enum WaitlistStatus {
  PENDING
  NOTIFIED
  BOOKED
  EXPIRED
  CANCELLED
}

enum FormStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum PackageStatus {
  ACTIVE
  USED_UP
  EXPIRED
  CANCELLED
}

// ============================================
// ORGANIZATION (MULTI-TENANT)
// ============================================

model Organization {
  id          String   @id @default(cuid())
  name        String   // "Kadıköy Psikoloji Merkezi"
  slug        String   @unique // "kadikoy-psikoloji"
  description String?
  logo        String?
  
  // Contact
  email       String?
  phone       String?
  website     String?
  address     String?
  city        String?
  country     String   @default("Turkey")
  
  // Business Info
  taxNumber   String?  @unique
  taxOffice   String?
  
  // Subscription & Billing
  subscriptionPlan   String   @default("trial") // trial, basic, premium, enterprise
  subscriptionStatus String   @default("active") // active, suspended, cancelled
  subscriptionExpiresAt DateTime?
  
  // Settings
  settings    Json?    // Klinik özel ayarlar
  isActive    Boolean  @default(true)
  
  // Relations
  users       User[]
  locations   Location[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([isActive])
  @@map("organizations")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  phone     String?    @unique
  password  String // hashed
  firstName String
  lastName  String
  role      UserRole   @default(CLIENT)
  status    UserStatus @default(PENDING_VERIFICATION)
  avatar    String?

  // Organization (Multi-Tenant)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // MFA
  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  // Metadata
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete

  // Relations
  therapistProfile TherapistProfile?
  clientProfile    ClientProfile?
  appointments     Appointment[]
  sessions         Session[]
  payments         Payment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  linkedAccounts   LinkedAccount[] @relation("MasterAccount")
  subAccounts      LinkedAccount[] @relation("SubAccount")
  waitlistRequests WaitlistRequest[]
  intakeForms       IntakeForm[]
  sessionPackages   SessionPackage[]
  calendarSyncs     CalendarSync[]
  dataExports       DataExport[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([organizationId])
  @@map("users")
}

model TherapistProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String? @unique
  specialization  String[]
  biography       String?
  yearsExperience Int?
  hourlyRate      Decimal @default(0) @db.Decimal(10, 2)

  // Availability settings
  workingHours Json? // { monday: { start: "09:00", end: "17:00", locationId: "xxx" }, ... }
  timeZone     String @default("Europe/Istanbul")
  
  // Location-based availability
  locations     TherapistLocation[]

  // Settings
  sessionDuration        Int     @default(50) // minutes
  allowOnlineBooking     Boolean @default(true)
  autoConfirmAppointment Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  sessions     Session[]
  waitlistRequests WaitlistRequest[]
  clients      ClientProfile[] // Clients assigned to this therapist
  
  @@map("therapist_profiles")
}

model TherapistLocation {
  id           String  @id @default(cuid())
  therapistId String
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  
  // Day-specific availability
  dayOfWeek    Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime    String // "09:00"
  endTime      String // "17:00"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([therapistId, locationId, dayOfWeek])
  @@index([therapistId])
  @@index([locationId])
  @@map("therapist_locations")
}

model ClientProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth  DateTime?
  gender       String?
  occupation   String?
  emergContact String?
  emergPhone   String?
  address      String?

  // Medical info (encrypted at application level)
  medicalHistory    String?
  currentMedication String?
  allergies         String?
  referredBy        String?

  // Therapist assignment
  therapistProfileId String?
  therapistProfile   TherapistProfile? @relation(fields: [therapistProfileId], references: [id], onDelete: SetNull)

  // Consent & Legal
  consentSigned      Boolean   @default(false)
  consentSignedAt    DateTime?
  recordingConsent   Boolean   @default(false)
  dataProcessConsent Boolean   @default(false)

  // Status
  isActive Boolean   @default(true)
  notes    String? // Internal notes (therapist only)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  sessions     Session[]
  
  @@index([userId])
  @@index([therapistProfileId])
  @@map("client_profiles")
}

// ============================================
// LOCATION & ROOM MANAGEMENT
// ============================================

model Location {
  id          String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name        String      // "Kadıköy Şube", "Nişantaşı Şube"
  type        LocationType @default(BRANCH)
  address     String?
  city        String?
  country     String      @default("Turkey")
  phone       String?
  email       String?
  isActive    Boolean     @default(true)
  
  // Relations
  rooms       Room[]
  therapistLocations TherapistLocation[]
  appointments Appointment[]
  waitlistRequests WaitlistRequest[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([isActive])
  @@map("locations")
}

model Room {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name        String   // "Oyun Terapisi Odası", "EMDR Odası"
  type        RoomType
  capacity    Int      @default(1)
  description String?
  isActive    Boolean  @default(true)
  
  // Relations
  appointments Appointment[]
  waitlistRequests WaitlistRequest[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([locationId])
  @@index([type])
  @@index([isActive])
  @@map("rooms")
}

// ============================================
// LINKED ACCOUNTS (FAMILY MANAGEMENT)
// ============================================

model LinkedAccount {
  id            String   @id @default(cuid())
  masterUserId  String
  masterUser    User     @relation("MasterAccount", fields: [masterUserId], references: [id], onDelete: Cascade)
  subUserId     String
  subUser       User     @relation("SubAccount", fields: [subUserId], references: [id], onDelete: Cascade)
  relationship  String   // "parent", "guardian", "spouse", "partner"
  isActive      Boolean  @default(true)
  
  // Privacy settings
  canViewNotes  Boolean  @default(false) // Ebeveyn seans notlarını görebilir mi?
  canViewPayments Boolean @default(true)  // Ebeveyn ödemeleri görebilir mi?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([masterUserId, subUserId])
  @@index([masterUserId])
  @@index([subUserId])
  @@map("linked_accounts")
}

// ============================================
// WAITLIST
// ============================================

model WaitlistRequest {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  therapistId String
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id])
  locationId  String?
  location    Location?      @relation(fields: [locationId], references: [id])
  roomId      String?
  room        Room?          @relation(fields: [roomId], references: [id])
  
  // Requested time slot
  preferredDate DateTime
  preferredTime  String // "14:00"
  duration       Int    @default(50) // minutes
  
  status      WaitlistStatus @default(PENDING)
  priority    Int            @default(0) // Higher number = higher priority
  
  // Notification
  notifiedAt  DateTime?
  notifiedCount Int @default(0)
  
  // If booked
  appointmentId String? @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  
  notes       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt  DateTime? // Auto-expire after X days
  
  @@index([therapistId, preferredDate])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("waitlist_requests")
}

// ============================================
// RECEPTION & CHECK-IN
// ============================================

model ReceptionCheckIn {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  checkedInAt   DateTime @default(now())
  checkedInBy   String?  // Assistant user ID (no relation needed, just store ID)
  waitTime      Int?     // minutes waited
  
  // Delay management
  delayMinutes  Int?     // Seans X dakika gecikiyor
  delayNotifiedAt DateTime?
  
  notes         String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([checkedInAt])
  @@map("reception_check_ins")
}

// ============================================
// INTAKE FORMS
// ============================================

model IntakeForm {
  id            String     @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  formType      String     // "general", "kvkk", "beck_depression", "custom"
  formData      Json       // Form answers
  formTemplate  Json?      // Form structure
  
  status        FormStatus @default(PENDING)
  completedAt   DateTime?
  signedAt      DateTime?
  signature     String?    // Digital signature
  
  // PDF storage
  pdfUrl        String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt  DateTime? // Form expires if not completed
  
  @@index([appointmentId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("intake_forms")
}

// ============================================
// SESSION PACKAGES
// ============================================

model SessionPackage {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String        // "10 Seans Paketi"
  totalSessions Int           // 10
  usedSessions  Int           @default(0)
  discount      Decimal?      @db.Decimal(5, 2) // 20.00 = %20
  price         Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @db.Decimal(10, 2)
  
  status        PackageStatus @default(ACTIVE)
  
  // Expiry
  purchasedAt   DateTime      @default(now())
  expiresAt     DateTime?
  
  // Relations
  payments      Payment[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("session_packages")
}

// ============================================
// CALENDAR SYNC
// ============================================

model CalendarSync {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider      String   // "google", "outlook", "apple"
  calendarId    String   // External calendar ID
  accessToken   String   // Encrypted
  refreshToken  String?  // Encrypted
  syncEnabled   Boolean  @default(true)
  
  // Sync direction
  syncToExternal Boolean @default(false) // System -> External
  syncFromExternal Boolean @default(true) // External -> System
  
  lastSyncAt    DateTime?
  nextSyncAt    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, provider])
  @@index([userId])
  @@index([syncEnabled])
  @@map("calendar_syncs")
}

// ============================================
// DATA EXPORT
// ============================================

model DataExport {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  exportType    String   @default("FULL") // FULL, APPOINTMENTS, SESSIONS, PAYMENTS
  
  // File storage
  fileUrl       String?
  fileSize      Int?     // bytes
  expiresAt     DateTime? // Download link expires
  
  // Processing
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  errorMessage  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("data_exports")
}

// ============================================
// APPOINTMENT & SESSION
// ============================================

model Appointment {
  id          String            @id @default(cuid())
  therapistId String
  therapist   TherapistProfile  @relation(fields: [therapistId], references: [id])
  clientId    String
  client      ClientProfile     @relation(fields: [clientId], references: [id])
  userId      String // redundant for quick queries
  user        User              @relation(fields: [userId], references: [id])

  // Schedule
  startTime DateTime
  endTime   DateTime
  duration  Int // minutes
  timeZone  String @default("Europe/Istanbul")

  // Status & Type
  status       AppointmentStatus @default(SCHEDULED)
  type         String            @default("individual") // individual, group, online, in-person
  isOnline     Boolean           @default(false)
  meetingLink  String?
  // location field moved to Location relation below

  // Notifications
  reminderSentAt DateTime?
  confirmedAt    DateTime?

  // Cancellation
  cancelledAt     DateTime?
  cancellationReason String?

  // Notes
  appointmentNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session?
  
  // Location & Room
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id])
  
  // Waitlist
  waitlistRequest WaitlistRequest?
  
  // Check-in
  checkIn ReceptionCheckIn?
  
  // Intake forms
  intakeForms IntakeForm[]
  
  @@index([therapistId, startTime])
  @@index([clientId, startTime])
  @@index([userId])
  @@index([status])
  @@index([startTime])
  @@index([locationId])
  @@index([roomId])
  @@map("appointments")
}

model Session {
  id            String @id @default(cuid())
  appointmentId String @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  therapistId String
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id])
  clientId    String
  client      ClientProfile    @relation(fields: [clientId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])

  // Session details
  sessionNumber Int? // e.g., 1st, 2nd session
  actualStart   DateTime?
  actualEnd     DateTime?
  duration      Int? // actual duration in minutes

  // Notes (field-level encrypted in app)
  clinicalNotes     String?
  treatmentPlan     String?
  progressNotes     String?
  diagnosis         String?
  interventions     String[]
  homework          String?
  riskAssessment    String?

  // AI/Recording
  recordingUrl      String?
  transcriptionUrl  String?
  aiSummary         String?

  // Status
  noteStatus SessionNoteStatus @default(DRAFT)
  signedAt   DateTime?
  signedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?
  
  // Privacy
  isPrivate Boolean @default(false) // Gizli not (ebeveyn göremez)

  @@index([therapistId])
  @@index([clientId])
  @@index([userId])
  @@index([isPrivate])
  @@map("sessions")
}

// ============================================
// PAYMENTS & BILLING
// ============================================

model Payment {
  id        String        @id @default(cuid())
  sessionId String?       @unique
  session   Session?      @relation(fields: [sessionId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])

  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("TRY")
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod @default(CASH)

  // Payment details
  paidAt          DateTime?
  paidAmount      Decimal?  @db.Decimal(10, 2)
  remainingAmount Decimal?  @db.Decimal(10, 2)

  // External integrations
  stripePaymentId String?
  iyzicoPaymentId String?
  invoiceUrl      String?
  receiptUrl      String?

  // Refund
  refundedAt     DateTime?
  refundAmount   Decimal?  @db.Decimal(10, 2)
  refundReason   String?

  notes String?
  
  // Session Package
  packageId String?
  package   SessionPackage? @relation(fields: [packageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paidAt])
  @@index([packageId])
  @@map("payments")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id     String             @id @default(cuid())
  userId String
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  status  NotificationStatus @default(PENDING)
  channel String // email, sms, whatsapp, push

  subject String?
  message String
  data    Json? // Additional structured data

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  errorMsg    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// AUDIT & SECURITY
// ============================================

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])

  action       String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  resource     String // User, Appointment, Session, etc.
  resourceId   String?
  changes      Json? // What changed
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

