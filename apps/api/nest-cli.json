{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "tsconfig.json",
    "builder": "tsc",
    "watchAssets": true,
    "assets": [
      {
        "include": "**/*.prisma",
        "watchAssets": true
      }
    ]
  }
}

