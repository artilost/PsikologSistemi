# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-change-this-in-production

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keycloak OAuth (Optional)
KEYCLOAK_CLIENT_ID=web-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8082/realms/psikolog-sistemi

# Sentry (Optional)
NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_ONLINE_BOOKING=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_VIDEO_CALLS=false

# Environment
NEXT_PUBLIC_ENV=development
